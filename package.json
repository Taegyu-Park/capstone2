{
  "name": "daily-news-digest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "매일 아침 전날의 뉴스 헤드라인과 요약을 분야별로 모아 GitHub Pages에 배포합니다.",
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "summarize": "node scripts/summarize.mjs",
    "render": "node scripts/render.mjs",
    "build": "node scripts/build.mjs",
    "check-feeds": "node scripts/check-feeds.mjs",
    "deploy": "gh workflow run daily-digest.yml -f deploy_only=true"
